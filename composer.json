{
    "name": "danog/php-rtc-stun",
    "type": "library",
    "description": "STUN transactions and NAT discovery for PHP, ported to Amp v3 sockets and fibers. MadelineProto's PHP 8.2+ fork supports the modular danog/php-rtc stack.",
    "keywords": [
        "webrtc",
        "stun",
        "SessionTraversalUtilitiesForNAT"
    ],
    "homepage": "https://github.com/danog/php-rtc-stun",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "amphp/socket": "^2.3",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-mixin": "^1.0",
        "ramsey/uuid": "^4.7",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "mockery/mockery": "^1.6",
        "dg/bypass-finals": "dev-master",
        "bamarni/composer-bin-plugin": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\STUN\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\STUN\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
